# ─── Contact Form ─────────────────────────────────────────────────────────────
# Web3Forms access key — get it at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Cloudflare Turnstile secret key — get it at https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile site key (public, safe to expose)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Upstash Redis REST URL and token — get them at https://console.upstash.com (free tier)
# If not set, rate limiting is disabled in development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
